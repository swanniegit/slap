# ============================================================================
# SLAP Baby Designs — root .htaccess.
#
# HAZARD: this is the highest-risk file in the repo. A syntax error here is an
# instant 500 on EVERY page, and `apachectl configtest` does NOT parse
# .htaccess — only a real HTTP request does. Never edit this without building
# the image and curling the site.
# ============================================================================

Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

RewriteEngine On
RewriteBase /

# ---- Force HTTPS -----------------------------------------------------------
# HAZARD: test =http EXACTLY, never !=https. TLS terminates at the Coolify
# proxy, so X-Forwarded-Proto is ABSENT on the container health check and on
# any local `docker run` test. An inverted test redirects those to https,
# nothing answers, and the deploy never goes healthy.
RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# ---- Canonical host: www -> apex --------------------------------------------
# DNS points both www and the apex at this server, so without this the whole
# site answers on two hostnames. The <link rel=canonical> already names the apex,
# but a 301 is what stops the duplicate being crawled, linked and shared at all.
#
# Placed AFTER the HTTPS rule so a http://www request makes one hop to
# https://www and then one to the apex, rather than being handed to a scheme
# that has no certificate. Keyed on the literal host, so adding a hostname later
# cannot silently start redirecting it.
RewriteCond %{HTTP_HOST} ^www\.slapbabydesigns\.co\.za$ [NC]
RewriteRule ^ https://slapbabydesigns.co.za%{REQUEST_URI} [R=301,L,NE]

# ---- Deny source, config and tooling ---------------------------------------
# Second layer behind .dockerignore, for anything that arrives another way.
# Path-based, because FilesMatch only ever sees the basename — /.git/HEAD has
# the perfectly innocent filename "HEAD".
RewriteRule ^(lib|partials|docker|scripts|vendor)/ - [F,L]
RewriteRule (^|/)\.(git|github|claude|env) - [F,L]
RewriteRule ^composer\.(json|lock)$ - [F,L]
RewriteRule \.md$ - [F,L]
RewriteRule \.dc\.html$ - [F,L]

# ---- Hashed CSS bundle -----------------------------------------------------
# assets/css.php concatenates assets/css/*.css and stamps the URL with a hash of
# their contents, so the year-long immutable cache below is safe: a change to
# any part produces a new filename. The hash is passed through so css.php can
# reject a stale one rather than serve mismatched bytes under a cached URL.
RewriteRule ^assets/site\.([a-f0-9]+)\.css$ assets/css.php?v=$1 [L,QSA]

# ---- Hashed brand assets ---------------------------------------------------
# lib/html.php's slap_brand_url() stamps the mark and the touch icon with a hash
# of their contents, and this strips it back off so Apache still serves the file
# from disk with no PHP in the request. Unlike the stylesheet there is no
# endpoint to hand a wrong hash to: any hash resolves to the current file, which
# is right, because the URL is only ever generated FROM that file's bytes.
# The unhashed path keeps working — site.webmanifest uses it.
RewriteRule ^assets/brand/([a-z0-9-]+)\.[a-f0-9]{8,32}\.(svg|png)$ assets/brand/$1.$2 [L]

# ---- Generated sitemap -----------------------------------------------------
# Built from lib/pages.php so lastmod cannot drift from the manifest. A static
# sitemap.xml with stale dates teaches Google to discount the signal.
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# ---- Generated robots.txt and web app manifest -----------------------------
# Both were static and both restated facts the PHP already holds. robots.txt
# named the apex host in its Sitemap: line even when this image answered as
# slap.yellowarcher.co.za; the manifest carried a description that had drifted
# from the JSON-LD, and icon paths that could not be content-hashed because JSON
# cannot call slap_brand_url().
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^site\.webmanifest$ site-webmanifest.php [L]

# NOTE: /enquiry/ is deliberately NOT rewritten. It handles its own POST and its
# path is a frozen contract with the form's action attribute — any tidy-up rule
# that touches it silently breaks every enquiry.

ErrorDocument 404 /404.php

# ---- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain \
        application/javascript application/json application/xml text/xml \
        image/svg+xml application/manifest+json
</IfModule>
# jpeg/webp/woff2 are already compressed; recompressing only burns CPU.

# ---- Caching ---------------------------------------------------------------
# HAZARD: no ExpiresDefault and no text/css entry, deliberately. mod_expires
# merges its own max-age into an existing Cache-Control, so either would collide
# with the header assets/css.php sets per-request — it serves "immutable" only
# when the requested hash matches the CSS on disk, and must stay in charge of
# that decision. Same reason text/html is absent: PHP pages set their own.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg    "access plus 1 year"
    ExpiresByType image/png     "access plus 1 year"
    ExpiresByType image/webp    "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # /assets/img/* and the fonts only. These are content the browser may keep
    # for a year, because a changed photo gets a new filename. .css is absent
    # for the css.php reason above; .js is below, and separately, because it
    # does NOT get a new filename when it changes.
    <FilesMatch "\.(jpe?g|png|webp|svg|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # ...but FilesMatch sees the basename, not the path, so the block above also
    # caught /assets/brand/. Those two files are the opposite case: fixed URLs
    # whose CONTENTS change. Marked immutable, redrawing the logo left every
    # returning visitor on the old one for a year with no way to reach them --
    # which is exactly the trap spelled out for site.js below, arrived at from
    # the other direction. A day is the staleness window for a mark that changes
    # about never; Expires has to be unset too, or mod_expires' own year-long
    # header from the block above outlives this one.
    # A hashed brand URL is safe to keep forever — that is the whole point of
    # putting the hash there, and it is what finally reaches a browser still
    # holding the old mark under the plain path. The plain path itself keeps the
    # short window: it is a fixed URL whose contents change, so it can never
    # honestly promise more than a day.
    # THE_REQUEST, not REQUEST_URI. By the time mod_headers runs, mod_rewrite has
    # already stripped the hash back off and REQUEST_URI reads
    # /assets/brand/mark.svg for both forms — so matching on it silently put the
    # hashed URL in the short-lived branch, which is the one thing this pair of
    # rules exists to prevent. THE_REQUEST is the original request line and is
    # never rewritten. Matched loosely at both ends because it also carries the
    # method and the protocol: "GET /... HTTP/1.1".
    <If "%{THE_REQUEST} =~ m# /assets/brand/[a-z0-9-]+\.[a-f0-9]{8,32}\.(svg|png)[ ?]#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    <ElseIf "%{REQUEST_URI} =~ m#^/assets/brand/#">
        Header set Cache-Control "public, max-age=86400"
        Header unset Expires
    </ElseIf>

    # NOT immutable. Unlike the stylesheet, /assets/js/site.js is served at a
    # fixed URL with no content hash in it, so "immutable" would mean a fix to
    # the nav script never reaching anyone who had already loaded the old one —
    # for a year, with no way to reach those browsers. An hour is plenty for a
    # 3KB file that is deferred and purely progressive enhancement.
    <FilesMatch "\.js$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy        "strict-origin-when-cross-origin"
    # DENY, not SAMEORIGIN: nothing on this site is ever framed, and a keepsake
    # business is exactly the sort of thing that gets clickjacked into a scam.
    Header always set X-Frame-Options        "DENY"
    Header always set Permissions-Policy     "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always unset X-Powered-By

    # HSTS is set only on genuinely-HTTPS requests, so a local container test
    # over plain HTTP cannot pin the developer's browser to https://localhost.
    # Starts short on purpose: preload is effectively irreversible. Raise to
    # 31536000 once the domain has run a clean week on HTTPS.
    Header always set Strict-Transport-Security "max-age=300" \
        "expr=%{HTTP:X-Forwarded-Proto} == 'https'"
</IfModule>
