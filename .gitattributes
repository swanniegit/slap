# Line endings are load-bearing here, so pin them rather than leaving the result
# to whatever core.autocrlf each machine happens to have:
#
#   .htaccess  uses backslash line continuations. A CRLF after the backslash is
#              not a continuation — Apache calls it a syntax error, and an
#              .htaccess syntax error is a 500 on EVERY page of the site.
#   *.sh       scripts/smoke.sh runs under bash in CI and in the container. A CR
#              at the end of a line becomes part of the command, and the failure
#              reads as bash: $'\r': command not found, which points nowhere near
#              the actual cause.
#   Dockerfile RUN lines use the same backslash continuations.
#   *.css      assets/css.php concatenates these and hashes the bytes. Mixed
#              endings between two checkouts would produce two different hashes
#              for identical CSS, so the cache-busting URL would change on a
#              deploy that changed nothing.

*.sh          text eol=lf
*.php         text eol=lf
*.css         text eol=lf
*.js          text eol=lf
*.ini         text eol=lf
*.conf        text eol=lf
*.yml         text eol=lf
*.json        text eol=lf
*.svg         text eol=lf
*.txt         text eol=lf
*.webmanifest text eol=lf
.htaccess     text eol=lf
.gitignore    text eol=lf
.dockerignore text eol=lf
.gitattributes text eol=lf
Dockerfile    text eol=lf

# Binaries must never be touched by newline handling.
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.webp binary
